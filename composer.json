{
  "name": "ambrion/evocms-feature-flags",
  "description": "Feature Flags module for EvolutionCMS CE 3 with rules engine, A/B testing and analytics",
  "type": "evolutioncms-package",
  "license": "MIT",
  "keywords": ["evolutioncms", "feature-flags", "ab-testing", "tdd", "ddd"],
  "support": {
    "issues": "https://github.com/Ambrion/evocms-feature-flags/issues",
    "source": "https://github.com/Ambrion/evocms-feature-flags",
    "docs": "https://github.com/Ambrion/evocms-feature-flags/blob/master/README.md"
  },
  "authors": [
    {
      "name": "Ambrion (Igor Brikov)",
      "email": "ping@ambrion.dev",
      "homepage": "https://ambrion.dev",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "ambrion/feature-flags-core": "^1.3@alpha"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "EvolutionCMS\\FeatureFlags\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EvolutionCMS\\FeatureFlags\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-html .coverage"
  },
  "extra": {
    "laravel": {
      "providers": [
        "EvolutionCMS\\FeatureFlags\\FeatureFlagsServiceProvider"
      ]
    }
  },
  "minimum-stability": "alpha",
  "prefer-stable": true
}
